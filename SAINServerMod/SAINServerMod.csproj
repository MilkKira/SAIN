<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ReleaseOutputDir>..\Build\SPT\user\mods\Solarint-SAIN-ServerMod\</ReleaseOutputDir>
    <LegacyReleaseArchive>..\Build\SPT\user\mods\Solarint-SAIN-ServerMod.rar</LegacyReleaseArchive>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SPTarkov.Common" Version="4.0.0" />
    <PackageReference Include="SPTarkov.DI" Version="4.0.0" />
    <PackageReference Include="SPTarkov.Reflection" Version="4.0.0" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.0.0" />
    <PackageReference Include="SPTarkov.Server.Web" Version="4.0.0" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="data\**\*" />
    <None Include="data\**\*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>data\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </None>
  </ItemGroup>
  <!-- Build script-->
  <Target Name="CleanUnwantedFiles" AfterTargets="Build">
    <ItemGroup>
      <UnwantedFiles Include="$(OutputPath)*.pdb;$(OutputPath)*.deps.json;$(OutputPath)*.endpoints.json;$(OutputPath)*.runtimeconfig.*;$(OutputPath)*.staticwebassets.*" />
    </ItemGroup>
    <Delete Files="@(UnwantedFiles)" />
  </Target>
  <Target Name="CopyBuildOutput" AfterTargets="CleanUnwantedFiles">
    <Delete Files="$(LegacyReleaseArchive)" />
    <RemoveDir Directories="$(ReleaseOutputDir)" />
    <MakeDir Directories="$(ReleaseOutputDir)" />
    <MakeDir Directories="$(ReleaseOutputDir)data" />
    <ItemGroup>
      <ServerDataFiles Include="$(ProjectDir)data\**\*" />
      <WebAssets Include="$(ProjectDir)wwwroot\**\*.*" />
    </ItemGroup>
    <Copy
      SourceFiles="$(OutputPath)SAINServerMod.dll"
      DestinationFolder="$(ReleaseOutputDir)"
    />
    <Copy
      SourceFiles="@(ServerDataFiles)"
      DestinationFiles="@(ServerDataFiles->'$(ReleaseOutputDir)data\%(RecursiveDir)%(Filename)%(Extension)')"
    />
    <Copy SourceFiles="@(WebAssets)" DestinationFiles="@(WebAssets->'$(ReleaseOutputDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
  <Target Name="CopyToServerMods" AfterTargets="CopyBuildOutput" Condition="'$(Configuration)' == 'Debug'">
    <PropertyGroup>
      <ServerModsDir>..\..\SPT\server-csharp\SPTarkov.Server\bin\Debug\$(TargetFramework)\user\mods\Solarint-SAIN-ServerMod\</ServerModsDir>
    </PropertyGroup>
    <MakeDir Directories="$(ServerModsDir)" />
    <ItemGroup>
      <ModFiles Include="$(ReleaseOutputDir)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ModFiles)" DestinationFiles="@(ModFiles->'$(ServerModsDir)%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
